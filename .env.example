# Gateway — single key proxies to OpenAI, Anthropic, Google, etc.
# https://mastra.ai/docs/models/gateways/mastra
MASTRA_GATEWAY_API_KEY=

# Postgres — primary storage (threads, messages, memory, workflow snapshots).
# Required.
DATABASE_URL=postgres://user:password@localhost:5432/mastra

# Mastra platform — powers @mastra/connect tools() and channels().
# Create a Mastra platform project, attach integrations to it
# (Linear, Notion, Slack, Telegram, Discord, …), then generate an access token.
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=

# Optional: the agent's name in Studio and in its replies. Mastra platform sets
# it from the name chosen during onboarding. Defaults to "AscendXI AI Co-Founder".
AGENT_NAME=

# Platform workspace — when set, the agent workspace uses PlatformSandbox and
# PlatformFilesystem instead of the local sandbox/filesystem.
# MASTRA_ENVIRONMENT_ID=
# MASTRA_PLATFORM_BUCKET_NAME=

# Optional: organization id (sent as x-organization-id when set)
# MASTRA_ORG_ID=

# Optional: platform region ('us' | 'eu'); defaults to the global endpoint
# MASTRA_PLATFORM_REGION=us

# Observational-memory model. Agent models use verified per-role profiles;
# choose an offered profile in the agent inspector. Gateway credential required.
ASCENDXI_MODEL=mastra/openai/gpt-6-luna

# Comma-separated EXACT Connect tool IDs independently reviewed as safe reads.
# Empty by default: every external tool requires human approval.
# Never list writes, generic HTTP tools, SQL executors or tools that combine reads and writes.
ASCENDXI_READ_TOOLS=

# Optional dedicated test database. Do not point at production.
# TEST_DATABASE_URL=postgres://localhost:5432/ascendxi_test

# On a custom host, public HTTPS URL for channel webhooks (not the bind address).
# MASTRA_SERVER_URL=https://your-agent.example.com

# Exact Connect tool grants per department; default no integration access.
# Replace sample IDs in docs/integrations.md with observed real tool IDs.
ASCENDXI_DEPARTMENT_TOOLS={}

# Required in production. Generate a high-entropy operator key; never commit it.
# Platform Studio keeps its organization login. Direct clients send Bearer <key>.
ASCENDXI_API_TOKEN=

# Trusted dashboard origins for reverse-proxied Studio writes. Exact origins only.
# ASCENDXI_UI_ORIGINS=https://your-project.studio.mastra.cloud,https://your-project.server.mastra.cloud

# Optional exact Connect tool IDs per specialist role; unknown roles fail startup.
# Role grants do not inherit the department lead's access. Writes remain approval-gated.
ASCENDXI_ROLE_TOOLS={}

# Optional continuous local macOS instance. Use a private .env.company-local.
# Native APIs remain protected; custom desk routes trust the local OS user only.
# Never expose local mode through a public reverse proxy.
ASCENDXI_LOCAL_MODE=false
ASCENDXI_LOCAL_WORKER=false
ASCENDXI_MAX_RUNS_PER_HOUR=4
# PORT=4111
# MASTRA_SERVER_URL=http://127.0.0.1:4111
# ASCENDXI_UI_ORIGINS=http://127.0.0.1:4111,http://localhost:4111

# Optional existing Mastra deployment used as an authenticated Connect bridge.
# URL and bearer token must belong to your trusted company deployment.
# ASCENDXI_CONNECT_BRIDGE_URL=https://your-project.server.mastra.cloud
# ASCENDXI_CONNECT_BRIDGE_TOKEN=

# Existing Discord company guild and three text channels. IDs are not credentials.
# Enable in Connections after verification. Uses the existing bridge bot;
# does not create new credentials, grant permissions, or enable broad message content.
# ASCENDXI_DISCORD_GUILD_ID=
# Optional existing bot identity for deterministic addressed status/help replies.
# ASCENDXI_DISCORD_BOT_USER_ID=
# ASCENDXI_DISCORD_OPERATIONS_CHANNEL=
# ASCENDXI_DISCORD_APPROVALS_CHANNEL=
# ASCENDXI_DISCORD_LEARNING_CHANNEL=

# Founder-selected routine autonomy. 0 disables the hourly job counter.
# This does not approve purchases, new tool access, client scope or deployment.
ASCENDXI_AUTONOMY=manual
